
# Worker payload copied under test/ for the browser suite. Generated by:
#   dart run spawn:build && cp lib/workers/build/*.dart.js test/workers/build/
# The test runner only serves the test tree, so lib/ is unreachable from a
# browser test. The SHIPPED payload lives in lib/workers/build/ and is an asset.
test/workers/build/

# The SHIPPED worker payloads. `build/` in ../.gitignore would swallow these,
# which would be silent and expensive: they are declared as package assets, and
# `pub publish` excludes ignored files — so the published package would promise
# a worker payload it does not contain, and every consumer would quietly fall
# back to doing the work on the main thread. Git cannot re-include a file whose
# parent directory is excluded, so the directory has to be un-ignored first.
!lib/workers/build/
lib/workers/build/*
# Only the payloads. dart2js also emits .map/.deps next to them (megabytes of
# source map, fetched only if someone opens devtools) and spawn:build writes a
# .stamp; none of that belongs to a consumer.
!lib/workers/build/*.dart.js
